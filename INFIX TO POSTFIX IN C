#include <stdio.h>
#include <stdlib.h>
#include <ctype.h>
#include <string.h>

#define MAX 100

// Stack structure for operators
char stack[MAX];
int top = -1;

// Push element onto stack
void push(char item) {
    if (top >= MAX - 1) {
        printf("Stack Overflow\n");
        return;
    }
    stack[++top] = item;
}

// Pop element from stack
char pop() {
    if (top < 0) {
        printf("Stack Underflow\n");
        return '\0';
    }
    return stack[top--];
}

// Peek at the top element of the stack
char peek() {
    if (top < 0) {
        return '\0';
    }
    return stack[top];
}

// Determine operator precedence
int precedence(char symbol) {
    switch (symbol) {
        case '^':
            return 3;
        case '*':
        case '/':
            return 2;
        case '+':
        case '-':
            return 1;
        default:
            return 0;
    }
}

// Convert Infix to Postfix
void infixToPostfix(char infix[], char postfix[]) {
    int i = 0, j = 0;
    char item;
    char x;

    while (infix[i] != '\0') {
        item = infix[i];

        // Case 1: If the scanned character is an operand, add it to output
        if (isalnum(item)) {
            postfix[j++] = item;
        }
        // Case 2: If it's an opening parenthesis, push it to stack
        else if (item == '(') {
            push(item);
        }
        // Case 3: If it's a closing parenthesis, pop until '(' is found
        else if (item == ')') {
            while ((x = pop()) != '(') {
                if (x == '\0') {
                    printf("Invalid Expression: Mismatched parentheses.\n");
                    exit(1);
                }
                postfix[j++] = x;
            }
        }
        // Case 4: If it's an operator
        else if (item == '+' || item == '-' || item == '*' || item == '/' || item == '^') {
            while (top != -1 && precedence(peek()) >= precedence(item)) {
                // Note: Right-associative operators like '^' usually need special handling, 
                // but for standard left-to-right evaluation mechanics, this handles basic cases.
                postfix[j++] = pop();
            }
            push(item);
        }
        i++;
    }

    // Pop all remaining operators from the stack
    while (top != -1) {
        char remaining = pop();
        if (remaining == '(') {
            printf("Invalid Expression: Mismatched parentheses.\n");
            exit(1);
        }
        postfix[j++] = remaining;
    }

    postfix[j] = '\0'; // Null-terminate the string
}

int main() {
    char infix[MAX], postfix[MAX];

    printf("Enter Infix Expression: ");
    // Safely read string with spaces stripped out
    scanf("%s", infix);

    infixToPostfix(infix, postfix);

    printf("Postfix Expression: %s\n", postfix);

    return 0;
}
