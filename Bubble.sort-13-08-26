#include <stdio.h>

int main()
{
    int n,Arr[n],temp,i,j;
    printf("Enter the value of n:");
    scanf("%d",&n);
    printf("Enter the elements:");
    for(int i=0;i<n;i++)
    {
        scanf("%d",&Arr[i]);
        for(i=0;i<n-1;i++)
        {
            for(j=0;j<n-1-i;j++)
            {
                if(Arr[j]>Arr[j-1])
                {
                    temp =Arr[j];
                    Arr[j]=Arr[j-1];
                    Arr[j-1]=temp;
            
                }
            }
        }
        for(i=0;i<n;i++)
        {
            printf("%d",Arr[i]);
        }
        return 0;
    }
